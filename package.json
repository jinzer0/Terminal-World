{
  "name": "terminal-world-prototype",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "A local terminal community and personal-space prototype",
  "type": "module",
  "bin": {
    "terminal-world": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "test:package": "node --test tests/package.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ink-tools/ink-mouse": "2.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ink": "8.0.0",
    "react": "19.3.0",
    "ssh2": "^1.17.0",
    "string-width": "8.3.0",
    "xterm-mouse": "1.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.3.0",
    "@types/ssh2": "^1.15.6",
    "typescript": "5.9.3"
  }
}
